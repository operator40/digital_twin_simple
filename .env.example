# PostgreSQL initialization. The application safely handles special characters.
POSTGRES_DB=dt_db_cmms
POSTGRES_USER=dt_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host port where the API will be available.
API_PORT=8000

# External CMMS connection.
CMMS_BASE_URL=http://cmms-url:port
CMMS_TOKEN=replace-me

# External SilverFrog Data Collector connection.
DC_BASE_URL=https://dc.dev2.sfrog.hu
DC_API_KEY=replace-me

# X-API-Key header value
INBOUND_API_KEY=change-this-api-key

# X-API-Key for the runtime asset-mapping administration endpoint.
MAPPING_ADMIN_API_KEY=change-this-mapping-admin-key

# Runtime paths. TOML files contain only version-controlled operating parameters.
DATA_DIR=./app/maintenance/prediction_out
PREDICTION_CONFIG_PATH=./config/prediction.toml
DATACOLLECTOR_CONFIG_PATH=./config/datacollector.toml
DATACOLLECTOR_REJECTED_LOG_PATH=./logs/datacollector_rejected.log
