# PostgreSQL initialization. The application safely handles special characters.
POSTGRES_DB=dt_db_cmms
POSTGRES_USER=dt_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Host port where the API will be available.
API_PORT=8000

# External CMMS connection. On Docker Desktop, host.docker.internal means Windows.
CMMS_BASE_URL=http://cmms-url:port
CMMS_TOKEN=replace-me

# X-API-Key header value
INBOUND_API_KEY=change-this-api-key
