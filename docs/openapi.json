{
  "openapi": "3.1.0",
  "info": {
    "title": "Asset Prediction API",
    "version": "1.0.0",
    "description": "A digital_twin_simple jelenlegi bejövő API-szerződése. A sikeresen validált munkalapot tartós adatbázis-queue-ba helyezi."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Helyi Docker Compose környezet"
    }
  ],
  "paths": {
    "/asset_predict": {
      "post": {
        "summary": "Predikciós feladat sorba állítása",
        "description": "Fogadja a CMMS munkalapadatait, és idempotensen sorba állítja a hozzájuk tartozó predikciós feladatot.",
        "operationId": "asset_predict_asset_predict_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetPredictIn"
              },
              "example": {
                "workorder_id": 1,
                "asset_id": 1,
                "failure_cause_id": 1,
                "failure_date": "2026-07-30T08:00:00",
                "ended": "2026-07-30T09:00:00",
                "type": "CORRECTIVE",
                "operation_ids": [
                  1
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "A predikciós feladat sorba állítva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPredictAccepted"
                },
                "example": {
                  "job_id": 123
                }
              }
            }
          },
          "400": {
            "description": "Hiányzó vagy érvénytelen kérésadat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Hiányzó vagy érvénytelen API-kulcs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing": {
                    "value": {
                      "detail": "API key is missing"
                    }
                  },
                  "invalid": {
                    "value": {
                      "detail": "API key is invalid"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "A predikciós feladat nem volt eltárolható",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sf_asset_mapping": {
      "post": {
        "summary": "CMMS–DC asset mappingek betöltése",
        "description": "Futás közben idempotensen létrehozza vagy kiegészíti a CMMS- és DC-eszközazonosítók kapcsolatát.",
        "operationId": "sf_asset_mapping_sf_asset_mapping_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetMappingBatchIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A mappingek feldolgozva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetMappingBatchResult"
                }
              }
            }
          },
          "400": {
            "description": "Érvénytelen mapping kérés"
          },
          "401": {
            "description": "Hiányzó vagy érvénytelen mapping admin API-kulcs"
          },
          "503": {
            "description": "A mappingek nem voltak eltárolhatók"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "AssetPredictAccepted": {
        "type": "object",
        "title": "AssetPredictAccepted",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "integer",
            "title": "Job Id"
          }
        }
      },
      "AssetMappingBatchIn": {
        "type": "object",
        "title": "AssetMappingBatchIn",
        "required": [
          "mappings"
        ],
        "properties": {
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/AssetMappingIn"
            }
          }
        }
      },
      "AssetMappingIn": {
        "type": "object",
        "title": "AssetMappingIn",
        "description": "At least one of cmms_asset_id or dc_asset_id is required.",
        "properties": {
          "cmms_asset_id": {
            "anyOf": [
              { "type": "integer", "exclusiveMinimum": 0 },
              { "type": "null" }
            ]
          },
          "dc_asset_id": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          }
        }
      },
      "AssetMappingBatchResult": {
        "type": "object",
        "title": "AssetMappingBatchResult",
        "required": [
          "created",
          "updated",
          "unchanged",
          "conflicts",
          "results"
        ],
        "properties": {
          "created": { "type": "integer" },
          "updated": { "type": "integer" },
          "unchanged": { "type": "integer" },
          "conflicts": { "type": "integer" },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetMappingItemResult"
            }
          }
        }
      },
      "AssetMappingItemResult": {
        "type": "object",
        "title": "AssetMappingItemResult",
        "required": [
          "status"
        ],
        "properties": {
          "cmms_asset_id": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }]
          },
          "dc_asset_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "status": {
            "type": "string",
            "enum": ["created", "updated", "unchanged", "conflict"]
          },
          "asset_id": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }]
          },
          "reason": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        }
      },
      "AssetPredictIn": {
        "type": "object",
        "title": "AssetPredictIn",
        "required": [
          "workorder_id",
          "asset_id",
          "failure_date",
          "ended",
          "type",
          "operation_ids"
        ],
        "properties": {
          "workorder_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Workorder Id"
          },
          "asset_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Asset Id",
            "description": "Külső CMMS-eszközazonosító; a Python-kódban cmms_asset_id."
          },
          "failure_cause_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Failure Cause Id",
            "description": "CORRECTIVE munkalap esetén kötelező."
          },
          "failure_date": {
            "type": "string",
            "format": "date-time",
            "title": "Failure Date"
          },
          "ended": {
            "type": "string",
            "format": "date-time",
            "title": "Ended",
            "description": "Nem lehet korábbi a failure_date értékénél."
          },
          "type": {
            "type": "string",
            "enum": [
              "PREVENTIVE",
              "CORRECTIVE"
            ],
            "title": "Type"
          },
          "operation_ids": {
            "type": "array",
            "minItems": 1,
            "title": "Operation Ids",
            "items": {
              "type": "integer"
            },
            "description": "Nem üres lista, amelynek minden eleme pozitív egész."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "title": "ErrorResponse",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "title": "Detail"
          }
        }
      }
    }
  }
}
